# URL da API da sua plataforma onde o lead será cadastrado
PLATFORM_API_URL=https://sua-plataforma.com/api/v1/leads

# Chave de autorização / Bearer Token da sua API (opcional)
PLATFORM_API_KEY=seu_token_aqui

# (Opcional) URL para onde redirecionar o usuário após o cadastro
# REDIRECT_AFTER_SUBMIT_URL=https://sua-plataforma.com/obrigado
