# Endpoint da API do CRM da Trainning (padrão)
CRM_API_URL=https://api.trainning.com.br/functions/v1/api-leads

# Chave da API enviada no header 'x-api-key'
CRM_API_KEY=sua_api_key_aqui

# (Opcional) URL para onde redirecionar o usuário após o cadastro (padrão: /obrigado.html)
REDIRECT_AFTER_SUBMIT_URL=/obrigado.html
